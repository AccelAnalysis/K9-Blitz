{
  "name": "k9-blitz",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node tools/qa/run-tests.mjs",
    "test:web": "node --test apps/web/test/*.test.mjs",
    "typecheck": "npx --yes --package typescript@6.0.2 tsc -p tsconfig.json",
    "qa:repo": "node tools/qa/repository-audit.mjs",
    "build:pages": "node tools/qa/build-pages.mjs",
    "qa": "npm run typecheck && npm run qa:repo && npm test && npm run build:pages"
  },
  "type": "module"
}
